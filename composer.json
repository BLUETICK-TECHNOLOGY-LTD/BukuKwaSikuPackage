    "illuminate/support": "^9.0|^10.0|^11.0|^12",
    "illuminate/routing": "^9.0|^10.0|^11.0|^12",
    "illuminate/database": "^9.0|^10.0|^11.0|^12",
    "guzzlehttp/guzzle": "^7.9",
    "illuminate/validation": "^9.0|^10.0|^11.0|^12"
  }
}
