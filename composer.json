{
  "name": "bluetick/bukukwasiku",
  "description": "Bluetick reusable Bukukwasiku module",
  "type": "library",
  "autoload": {
    "psr-4": {
      "BukukwasikuPackage\\": "src/"
    }
  },
  "extra": {
